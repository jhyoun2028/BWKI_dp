<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard: nur HTTPS (die ngrok-Adresse ist HTTPS).
  Ausnahmen nur für lokale Entwicklung: Emulator-Host und localhost.
  Wer den Server im eigenen WLAN per http://192.168.x.x betreibt, muss die
  passende Adresse hier als weitere <domain>-Zeile eintragen.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
